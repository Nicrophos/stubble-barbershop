# Укажи доступ к своей локальной базе данных PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/stubble_db

# Произвольная длинная случайная строка (32+ символа)
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

PORT=3000
NODE_ENV=development

# Для лабораторной: ссылка восстановления выводится в окне вместо отправки почты.
# На публичном сервере нужно настроить отправку на почту и выключить этот режим.
DEMO_RESET_LINK=true
